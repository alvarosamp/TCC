{
  "profile_name": "example_domain_v1",
  "profile_version": "1.0.0",
  "task": "binary_anomaly_detection",
  "domain": "example_domain",
  "description": "Template de profile para um dominio de series temporais.",
  "sampling_rate": 1000.0,
  "window_size": 1024,
  "window_seconds": 1.024,
  "step_seconds": 0.512,
  "overlap": 0.5,
  "normal_label": 0,
  "anomaly_label": 1,
  "normal_name": "normal",
  "anomaly_name": "anomalo",
  "split_name": "domain_safe_split",
  "primary_metric": "auc_pr",
  "secondary_metrics": ["auc_roc", "f1", "precision", "recall"],
  "preprocessing": {
    "offline_pipeline": [
      "domain_specific_raw_to_window",
      "optional_filter",
      "zscore_per_window"
    ],
    "edge_pipeline": [
      "edge_compatible_filter",
      "zscore_per_window"
    ],
    "remove_response_offline": false,
    "remove_response_embedded": false,
    "bandpass_hz": null,
    "normalization": "zscore_per_window"
  },
  "embedded": {
    "target": "esp32",
    "runtime": "tensorflow_lite_micro",
    "decision_interval_ms": 10000,
    "preprocessing_version": "example_edge_preproc_v1",
    "ota_strategy_initial": "firmware_full_image",
    "ota_strategy_future": "separate_model_partition"
  }
}